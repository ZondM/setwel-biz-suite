//+------------------------------------------------------------------+
//|                                                 SL_Enforcer.mq5  |
//|  v3 - stop-loss enforcer + profit locker + built-in voice (MT5)  |
//|                                                                  |
//|  1) NO STOP LOSS ENFORCEMENT (voice)                             |
//|     1/3 reminder -> 2/3 warning -> 3/3 voice countdown           |
//|     "SL enforcer will close your trade in 60 / 30 / 20 / 10      |
//|      seconds ... 5 4 3 2 1"                                      |
//|     At zero: a LOSING trade is closed. A trade IN PROFIT is      |
//|     never closed - it gets a breakeven stop loss instead.        |
//|     Setting a stop loss at any time cancels the countdown.       |
//|                                                                  |
//|  2) PROFIT LOCK (every watched trade, with or without SL)        |
//|     - waits until the trade is in profit                         |
//|     - from ActivateUSD ($5) floating profit it moves the SL      |
//|       into profit: first FirstLockUSD, then LockPercent of the   |
//|       best profit reached                                        |
//|     - only ever tightens, never loosens                          |
//|     - always keeps at least MinDistanceATR x ATR between price   |
//|       and SL, so normal wicks do not close the trade early       |
//|     - moves only in StepUSD steps, max once per CooldownSec      |
//|     - never touches your take profit                             |
//|                                                                  |
//|  v3: ONE FILE - all voice sounds are built in.                   |
//|  Install: MQL5\Experts, compile, attach to ONE chart.            |
//|  In the EA window tick "Allow DLL imports" (for the voice) and   |
//|  keep Algo Trading ON. Without DLL imports it uses MT5's         |
//|  built-in alert sound instead.                                   |
//+------------------------------------------------------------------+
#include <Trade\Trade.mqh>

//--- Windows sound player: plays the voice straight from memory (needs "Allow DLL imports")
#import "winmm.dll"
int PlaySoundW(uchar &data[],long hmod,uint flags);
#import
#define SND_ASYNC     0x0001
#define SND_NODEFAULT 0x0002
#define SND_MEMORY    0x0004

//--- embedded voice sounds (8 kHz 8-bit WAV), generated - do not edit
