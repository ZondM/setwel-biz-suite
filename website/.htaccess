# Setwel Biz Suite — website root config

# index.html is the default page for any folder
DirectoryIndex index.html

# Custom 404 — pointing at a page that actually exists on every deploy,
# so a missing/renamed page never shows a bare, unbranded server error
# (or worse, a double "ErrorDocument also not found" failure).
ErrorDocument 404 /404.html

# Don't let visitors browse folder contents directly
Options -Indexes

# Don't leak server version info in error pages
ServerSignature Off

# Pages and the service worker must always be revalidated — a code fix
# pushed to the server has to show up on the next visit, not whenever a
# browser's own HTTP cache (separate from the service worker's cache)
# decides to expire.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
