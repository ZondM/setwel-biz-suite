{%- comment -%}
  Micheals Dynamics — Google map + contact details. No API key needed.
  Add it on the Contact page: Customize > Pages > Contact > Add section > "MD Map & contact".
{%- endcomment -%}

<section class="md-map page-width">
  <div class="md-map__grid">
    <div>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.address | escape }}</p>
      <p>
        Phone / WhatsApp: <a href="tel:{{ section.settings.phone_1 | remove: ' ' }}">{{ section.settings.phone_1 }}</a>
        {%- if section.settings.phone_2 != blank %} · <a href="tel:{{ section.settings.phone_2 | remove: ' ' }}">{{ section.settings.phone_2 }}</a>{% endif %}
      </p>
      <p>Email: <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
      {%- if section.settings.hours != blank -%}<p>Hours: {{ section.settings.hours | escape }}</p>{%- endif -%}
    </div>
    <iframe
      title="Map to {{ section.settings.address | escape }}"
      src="https://www.google.com/maps?q={{ section.settings.address | url_encode }}&output=embed"
      loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</section>

<style>
  .md-map { padding: 2.4rem 1.6rem; }
  .md-map__grid { display: grid; gap: 2rem; }
  .md-map a { color: #0B6E78; }
  .md-map iframe { width: 100%; height: 32rem; border: 0; border-radius: .6rem; }
  @media (min-width: 750px) { .md-map__grid { grid-template-columns: 1fr 1.4fr; } }
</style>

{% schema %}
{
  "name": "MD Map & contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit or contact us" },
    { "type": "text", "id": "address", "label": "Address (also used for the map)", "default": "33483 Hluhla Street, Harare, Khayelitsha, Cape Town, 7784" },
    { "type": "text", "id": "phone_1", "label": "Phone 1", "default": "074 742 3962" },
    { "type": "text", "id": "phone_2", "label": "Phone 2", "default": "071 076 2953" },
    { "type": "text", "id": "email", "label": "Email", "default": "michealsdynamicresults@gmail.com" },
    { "type": "text", "id": "hours", "label": "Trading hours", "info": "e.g. Mon–Fri 08:00–17:00, Sat 09:00–13:00" }
  ],
  "presets": [{ "name": "MD Map & contact" }]
}
{% endschema %}
