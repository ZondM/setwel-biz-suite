# Copy this file to ".env" and fill it in. Never share or commit the real .env file.

# Your live web address (no trailing slash) and port
BASE_URL=https://michealsdynamics.co.za
PORT=3000
NODE_ENV=production
# Where the database and uploaded photos are stored (back this folder up!)
DATA_DIR=./data

# First admin login (created on first start; change the password in Admin > Settings afterwards)
ADMIN_EMAIL=michealsdynamicresults@gmail.com
ADMIN_PASSWORD=choose-a-long-password-here

# Email sending. Gmail: turn on 2-step verification, then create an "App password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=michealsdynamicresults@gmail.com
SMTP_PASS=
MAIL_FROM=Micheals Dynamics <michealsdynamicresults@gmail.com>
ADMIN_NOTIFY_EMAIL=michealsdynamicresults@gmail.com

# PayFast (payfast.io > Settings > Developer settings). Set a passphrase there and copy it here.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# true while testing with a sandbox account, false (or remove) when live
PAYFAST_SANDBOX=false

# Yoco (optional, portal.yoco.com > Sales > Payment gateway > API keys)
YOCO_SECRET_KEY=
# Filled in by:  npm run yoco:webhook
YOCO_WEBHOOK_SECRET=
