input int    Warn1Sec           = 10;      // 1/3 reminder
input int    Warn2Sec           = 60;      // 2/3 warning
input int    Warn3Sec           = 120;     // 3/3 voice countdown starts
input int    CloseSec           = 180;     // countdown reaches zero
input bool   AutoClose          = true;    // close losing trades at zero
input bool   NeverCloseInProfit = true;    // trade in profit at zero -> breakeven SL instead of closing

input group "Profit lock"
input bool   UseProfitLock      = true;
input double ActivateUSD        = 5.0;     // start locking from this floating profit ($)
input double FirstLockUSD       = 1.0;     // first lock secures this much ($)
input double LockPercent        = 50.0;    // then lock this % of the best profit reached
input double StepUSD            = 1.0;     // move SL only when the lock grows by this much ($)
input double MinDistanceATR     = 1.0;     // SL never closer than this x ATR to price
input ENUM_TIMEFRAMES ATR_TF    = PERIOD_M5;
input int    ATR_Period         = 14;
input int    CooldownSec        = 10;      // minimum seconds between SL moves per trade
input double AnnounceEveryUSD   = 5.0;     // voice "profit locked" every time lock grows by this

input group "Alerts"
input bool   UseVoice           = true;    // built-in voice (needs "Allow DLL imports")
input bool   PopupAlert         = true;
input bool   PushAlert          = true;    // MetaQuotes ID in Tools > Options > Notifications
input bool   ShowPanel          = true;

struct Track
{
   ulong    ticket;
   datetime first;        // first seen without SL (0 = has SL)
   int      stage;        // 0..3 no-SL stage
   int      spoken;       // last countdown number spoken
   double   peak;         // best floating profit $
   double   locked;       // $ currently locked by SL
   double   announced;    // last locked $ announced by voice
   bool     managing;     // profit lock active
   datetime lastMod;
};

CTrade   trade;
Track    tr[];
string   atrSym[];
int      atrH[];
string   Pref="SLENF_";
bool     blink=false;

//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetDeviationInPoints(100);
   EventSetTimer(1);
   Print("SL Enforcer v3 started");
   if(UseVoice && (!TerminalInfoInteger(TERMINAL_DLLS_ALLOWED) || !MQLInfoInteger(MQL_DLLS_ALLOWED)))
      Alert("SL Enforcer: tick 'Allow DLL imports' in the EA settings to hear the voice. Using normal alert sound for now.");
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   EventKillTimer();
   ObjectsDeleteAll(0,Pref);
   for(int i=0;i<ArraySize(atrH);i++) IndicatorRelease(atrH[i]);
}

//+------------------------------------------------------------------+
bool PlayMem(uchar &snd[])
{
   if(!TerminalInfoInteger(TERMINAL_DLLS_ALLOWED) || !MQLInfoInteger(MQL_DLLS_ALLOWED)) return(false);
   return(PlaySoundW(snd,0,SND_MEMORY|SND_ASYNC|SND_NODEFAULT)!=0);
}

// file name like "sle_close_60.wav" -> embedded sound
void Voice(string file)
{
   if(!UseVoice) return;
   string k=file;
   StringReplace(k,"sle_",""); StringReplace(k,".wav","");
   bool ok=false;
   if(k=="1")             ok=PlayMem(SND_1);
   else if(k=="2")        ok=PlayMem(SND_2);
   else if(k=="3")        ok=PlayMem(SND_3);
   else if(k=="4")        ok=PlayMem(SND_4);
   else if(k=="5")        ok=PlayMem(SND_5);
   else if(k=="cannot")   ok=PlayMem(SND_CANNOT);
   else if(k=="close_10") ok=PlayMem(SND_CLOSE_10);
   else if(k=="close_20") ok=PlayMem(SND_CLOSE_20);
   else if(k=="close_30") ok=PlayMem(SND_CLOSE_30);
   else if(k=="close_60") ok=PlayMem(SND_CLOSE_60);
   else if(k=="closed")   ok=PlayMem(SND_CLOSED);
   else if(k=="locked")   ok=PlayMem(SND_LOCKED);
   else if(k=="managing") ok=PlayMem(SND_MANAGING);
   else if(k=="reminder") ok=PlayMem(SND_REMINDER);
   else if(k=="slset")    ok=PlayMem(SND_SLSET);
   else if(k=="warning")  ok=PlayMem(SND_WARNING);
   if(!ok) PlaySound("alert.wav");          // DLL imports off -> built-in MT5 sound
}

void Msg(string text,string sound)
{
   Print(text);
   Voice(sound);
   if(PopupAlert) Alert(text);
   if(PushAlert)  SendNotification(text);
}

int Find(ulong ticket)
{
   for(int i=0;i<ArraySize(tr);i++) if(tr[i].ticket==ticket) return(i);
   return(-1);
}

void Remove(int idx)
{
   int n=ArraySize(tr);
   for(int i=idx;i<n-1;i++) tr[i]=tr[i+1];
   ArrayResize(tr,n-1);
}

bool Watched()
{
   if(CurrentSymbolOnly && PositionGetString(POSITION_SYMBOL)!=_Symbol) return(false);
   if(OnlyMagic>=0 && PositionGetInteger(POSITION_MAGIC)!=OnlyMagic)    return(false);
   return(true);
}

string Desc(ulong ticket)
{
   string side=(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY)? "BUY" : "SELL";
   return(StringFormat("%s %s %.2f #%I64u",side,PositionGetString(POSITION_SYMBOL),
          PositionGetDouble(POSITION_VOLUME),ticket));
}

double ATRof(string sym)
{
   int idx=-1;
   for(int i=0;i<ArraySize(atrSym);i++) if(atrSym[i]==sym) { idx=i; break; }
   if(idx<0)
   {
      idx=ArraySize(atrSym);
      ArrayResize(atrSym,idx+1); ArrayResize(atrH,idx+1);
      atrSym[idx]=sym; atrH[idx]=iATR(sym,ATR_TF,ATR_Period);
   }
   if(atrH[idx]==INVALID_HANDLE) return(0);
   double v[];
   if(CopyBuffer(atrH[idx],0,1,1,v)<1) return(0);
   return(v[0]);
}

bool CanTrade()
{
   return(TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) && MQLInfoInteger(MQL_TRADE_ALLOWED));
}

// $ value of one full price unit for this position
double USDPerPrice(string sym,double vol)
{
   double tv=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_VALUE_PROFIT);
   if(tv<=0) tv=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_VALUE);
   double ts=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE);
   if(tv<=0 || ts<=0 || vol<=0) return(0);
   return(vol*tv/ts);
}

//+------------------------------------------------------------------+
//| Move SL to lock profit. Returns true if SL was modified.         |
//+------------------------------------------------------------------+
bool TrySetSL(ulong ticket,double newSL)
{
   string sym=PositionGetString(POSITION_SYMBOL);
   int    dg=(int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
   double tp=PositionGetDouble(POSITION_TP);
   newSL=NormalizeDouble(newSL,dg);
   return(trade.PositionModify(ticket,newSL,tp) && trade.ResultRetcode()==TRADE_RETCODE_DONE);
}

// best allowed SL price for locking 'usd' profit, respecting distance rules. 0 = not possible yet
double LockPrice(double usd)
{
   string sym=PositionGetString(POSITION_SYMBOL);
   bool   buy=(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY);
   double op=PositionGetDouble(POSITION_PRICE_OPEN);
   double vol=PositionGetDouble(POSITION_VOLUME);
   double upp=USDPerPrice(sym,vol);
   if(upp<=0) return(0);
   double pt=SymbolInfoDouble(sym,SYMBOL_POINT);
   double bid=SymbolInfoDouble(sym,SYMBOL_BID), ask=SymbolInfoDouble(sym,SYMBOL_ASK);
   double atr=ATRof(sym);
   double stopLvl=(double)SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL)*pt;
   double freeze =(double)SymbolInfoInteger(sym,SYMBOL_TRADE_FREEZE_LEVEL)*pt;
   double room=MathMax(MathMax(MinDistanceATR*atr,stopLvl),freeze)+pt;

   double sl=buy? op+usd/upp : op-usd/upp;
   if(buy) { double cap=bid-room; if(sl>cap) sl=cap; if(sl<=op) return(0); }
   else    { double cap=ask+room; if(sl<cap) sl=cap; if(sl>=op) return(0); }
   return(sl);
}

double LockedUSD(double sl)
{
   string sym=PositionGetString(POSITION_SYMBOL);
   bool   buy=(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY);
   double op=PositionGetDouble(POSITION_PRICE_OPEN);
   double upp=USDPerPrice(sym,PositionGetDouble(POSITION_VOLUME));
   if(sl==0 || upp<=0) return(0);
   return((buy? sl-op : op-sl)*upp);
}

void ManageProfit(int idx,ulong ticket)
{
   double profit=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
   if(profit>tr[idx].peak) tr[idx].peak=profit;
   if(!UseProfitLock || tr[idx].peak<ActivateUSD) return;

   bool   buy=(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY);
   double curSL=PositionGetDouble(POSITION_SL);
   string d=Desc(ticket);

   if(!tr[idx].managing)
   {
      tr[idx].managing=true;
      Msg(StringFormat("SL Enforcer: %s in profit $%.2f - now managing, locking profit",d,profit),"sle_managing.wav");
   }

   double want=MathMax(FirstLockUSD,tr[idx].peak*LockPercent/100.0);
   double have=LockedUSD(curSL);
   if(have<0) have=0;
   if(curSL!=0 && have>0 && want<have+StepUSD) return;            // not a big enough step
   if(TimeLocal()-tr[idx].lastMod<CooldownSec) return;
   if(!CanTrade()) return;

   double sl=LockPrice(want);
   if(sl==0) return;                                              // price too close, wait
   bool better= curSL==0 || (buy? sl>curSL : sl<curSL);
   if(!better) return;

   if(TrySetSL(ticket,sl))
   {
      tr[idx].lastMod=TimeLocal();
      tr[idx].locked=LockedUSD(sl);
      string t=StringFormat("SL Enforcer: profit locked $%.2f on %s (best $%.2f)",tr[idx].locked,d,tr[idx].peak);
      Print(t);
      if(tr[idx].locked>=tr[idx].announced+AnnounceEveryUSD || tr[idx].announced==0)
      {
         tr[idx].announced=tr[idx].locked;
         Voice("sle_locked.wav");
         if(PushAlert) SendNotification(t);
      }
   }
}

//+------------------------------------------------------------------+
void SpeakCountdown(int idx,int left)
{
   int marks[]={60,30,20,10,5,4,3,2,1};
   for(int m=0;m<ArraySize(marks);m++)
   {
      int n=marks[m];
      if(left<=n && tr[idx].spoken>n)
      {
         tr[idx].spoken=n;
         if(n>=10) Voice("sle_close_"+IntegerToString(n)+".wav");
         else      Voice("sle_"+IntegerToString(n)+".wav");
         return;
      }
   }
}

void EnforceNoSL(int idx,ulong ticket)
{
   datetime now=TimeLocal();
   if(tr[idx].first==0) { tr[idx].first=now; tr[idx].stage=0; tr[idx].spoken=9999; }
   int el=(int)(now-tr[idx].first);
   int left=CloseSec-el;
   string d=Desc(ticket);

   if(tr[idx].stage<1 && el>=Warn1Sec)
   { tr[idx].stage=1; Msg("SL Enforcer REMINDER 1/3: "+d+" has NO STOP LOSS. Set it now.","sle_reminder.wav"); return; }
   if(tr[idx].stage<2 && el>=Warn2Sec)
   { tr[idx].stage=2; Msg("SL Enforcer WARNING 2/3: "+d+" STILL has NO STOP LOSS!","sle_warning.wav"); return; }
   if(tr[idx].stage<3 && el>=Warn3Sec)
   {
      tr[idx].stage=3;
      string t=StringFormat("SL Enforcer FINAL 3/3: %s will be closed in %d seconds - NO STOP LOSS!",d,left);
      Print(t); if(PopupAlert) Alert(t); if(PushAlert) SendNotification(t);
   }
   if(tr[idx].stage>=3 && left>0) { SpeakCountdown(idx,left); return; }

   if(tr[idx].stage>=3 && left<=0 && AutoClose)
   {
      if(!CanTrade())
      {
         if(el%30==0) Msg("SL Enforcer: CANNOT act on "+d+" - ALGO TRADING IS OFF. Set a stop loss!","sle_cannot.wav");
         return;
      }
      double profit=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
      if(NeverCloseInProfit && profit>0)
      {
         // in profit: protect at breakeven instead of closing
         bool   buy=(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY);
         double op=PositionGetDouble(POSITION_PRICE_OPEN);
         string sym=PositionGetString(POSITION_SYMBOL);
         double pt=SymbolInfoDouble(sym,SYMBOL_POINT);
         double room=MathMax((double)SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL),
                             (double)SymbolInfoInteger(sym,SYMBOL_TRADE_FREEZE_LEVEL))*pt+pt;
         double px=buy? SymbolInfoDouble(sym,SYMBOL_BID) : SymbolInfoDouble(sym,SYMBOL_ASK);
         bool fits= buy? (px-op>room) : (op-px>room);
         if(fits && TrySetSL(ticket,op))
            Msg("SL Enforcer: "+d+" was in profit - breakeven stop loss set instead of closing","sle_slset.wav");
         return;                                   // otherwise keep waiting, never close a winner
      }
      if(trade.PositionClose(ticket))
         Msg("SL Enforcer: CLOSED "+d+" - it had NO STOP LOSS.","sle_closed.wav");
      else if(el%10==0)
         Print("SL Enforcer: close failed on ",d,": ",trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
void Panel(int worst,int left,string what,string lines)
{
   string bg=Pref+"BG", t1=Pref+"T1", t2=Pref+"T2", t3=Pref+"T3";
   if(!ShowPanel || (worst<1 && lines==""))
   { ObjectDelete(0,bg); ObjectDelete(0,t1); ObjectDelete(0,t2); ObjectDelete(0,t3); ChartRedraw(); return; }
   blink=!blink;
   if(ObjectFind(0,bg)<0)
   {
      ObjectCreate(0,bg,OBJ_RECTANGLE_LABEL,0,0,0);
      ObjectSetInteger(0,bg,OBJPROP_XDISTANCE,180); ObjectSetInteger(0,bg,OBJPROP_YDISTANCE,40);
      ObjectSetInteger(0,bg,OBJPROP_XSIZE,760);     ObjectSetInteger(0,bg,OBJPROP_YSIZE,96);
      ObjectSetInteger(0,bg,OBJPROP_BORDER_TYPE,BORDER_FLAT);
      ObjectSetInteger(0,bg,OBJPROP_SELECTABLE,false);
      for(int k=1;k<=3;k++)
      {
         string n=Pref+"T"+IntegerToString(k);
         ObjectCreate(0,n,OBJ_LABEL,0,0,0);
         ObjectSetInteger(0,n,OBJPROP_XDISTANCE,195);
         ObjectSetInteger(0,n,OBJPROP_YDISTANCE,k==1? 48 : (k==2? 82 : 102));
         ObjectSetInteger(0,n,OBJPROP_FONTSIZE,k==1? 16 : 10);
         ObjectSetString(0,n,OBJPROP_FONT,k==1? "Arial Black" : "Arial");
         ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
      }
   }
   color back,fore;
   string l1;
   if(worst>=3)      { back=blink? clrMaroon : clrBlack; fore=clrWhite;  l1=StringFormat("NO STOP LOSS - SL ENFORCER WILL CLOSE YOUR TRADE IN %d s",MathMax(left,0)); }
   else if(worst>=1) { back=clrBlack; fore=clrOrange; l1=StringFormat("NO STOP LOSS - %s %d/3",worst==1? "REMINDER" : "WARNING",worst); }
   else              { back=clrBlack; fore=clrLime;   l1="SL ENFORCER - managing trades in profit"; }
   ObjectSetInteger(0,bg,OBJPROP_BGCOLOR,back);
   ObjectSetInteger(0,bg,OBJPROP_COLOR,fore);
   ObjectSetString(0,t1,OBJPROP_TEXT,l1);                 ObjectSetInteger(0,t1,OBJPROP_COLOR,fore);
   ObjectSetString(0,t2,OBJPROP_TEXT,worst>=1? what+"  -> set a stop loss now" : " "); ObjectSetInteger(0,t2,OBJPROP_COLOR,fore);
   ObjectSetString(0,t3,OBJPROP_TEXT,lines==""? " " : lines); ObjectSetInteger(0,t3,OBJPROP_COLOR,clrLime);
   ChartRedraw();
}

//+------------------------------------------------------------------+
void OnTimer()
{
   int worst=0, left=INT_MAX;
   string what="", lines="";

   for(int i=ArraySize(tr)-1;i>=0;i--)
      if(!PositionSelectByTicket(tr[i].ticket)) Remove(i);

   for(int p=PositionsTotal()-1;p>=0;p--)
   {
      ulong ticket=PositionGetTicket(p);
      if(ticket==0 || !Watched()) continue;

      int idx=Find(ticket);
      if(idx<0)
      {
         idx=ArraySize(tr); ArrayResize(tr,idx+1);
         tr[idx].ticket=ticket; tr[idx].first=0; tr[idx].stage=0; tr[idx].spoken=9999;
         tr[idx].peak=0; tr[idx].locked=0; tr[idx].announced=0; tr[idx].managing=false; tr[idx].lastMod=0;
      }

      // profit lock runs first: it can give a no-SL trade its stop loss
      ManageProfit(idx,ticket);
      if(!PositionSelectByTicket(ticket)) continue;

      double sl=PositionGetDouble(POSITION_SL);
      if(sl!=0)
      {
         if(tr[idx].stage>=1)
         {
            string ok="SL Enforcer: stop loss set on "+Desc(ticket)+" - countdown cancelled";
            Print(ok); Voice("sle_slset.wav"); if(PushAlert) SendNotification(ok);
         }
         tr[idx].first=0; tr[idx].stage=0; tr[idx].spoken=9999;
      }
      else if(EnforceSL)
      {
         EnforceNoSL(idx,ticket);
         if(!PositionSelectByTicket(ticket)) continue;
         if(tr[idx].stage>=1)
         {
            int l=CloseSec-(int)(TimeLocal()-tr[idx].first);
            if(tr[idx].stage>worst || (tr[idx].stage==worst && l<left)) { worst=tr[idx].stage; left=l; what=Desc(ticket); }
         }
      }

      if(tr[idx].managing && StringLen(lines)<200)
         lines+=StringFormat("#%I64u  profit $%.2f  best $%.2f  locked $%.2f    ",ticket,
                PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP),tr[idx].peak,
                LockedUSD(PositionGetDouble(POSITION_SL)));
   }
   Panel(worst,left,what,lines);
}
//+------------------------------------------------------------------+
