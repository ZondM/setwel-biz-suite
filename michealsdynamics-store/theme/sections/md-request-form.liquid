{%- comment -%}
  Micheals Dynamics — "Request a Quote" and "Business account application" form.
  Submissions arrive by email (Settings > Notifications > Staff order notifications / store email).
  Shopify's built-in form cannot accept file uploads, so customers are asked to email or
  WhatsApp their order list. For an upload button, use a form app instead (see README).
{%- endcomment -%}

{%- liquid
  assign is_quote = false
  if section.settings.mode == 'quote'
    assign is_quote = true
  endif
  assign wa_number = section.settings.whatsapp_number | remove: ' ' | remove: '+'
-%}

<section class="md-form page-width">
  <h2>{{ section.settings.heading | escape }}</h2>
  {%- if section.settings.intro != blank -%}<div class="md-form__intro">{{ section.settings.intro }}</div>{%- endif -%}

  {%- form 'contact', id: section.id, class: 'md-form__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="md-form__ok" tabindex="-1" autofocus>Thank you — we received your request and will reply within one business day.</p>
    {%- endif -%}
    {{ form.errors | default_errors }}

    <input type="hidden" name="contact[Form]" value="{% if is_quote %}Quote request{% else %}Business account application{% endif %}">

    <label>Your name *<input name="contact[name]" required autocomplete="name"></label>
    <label>Practice / organisation name *<input name="contact[Organisation]" required autocomplete="organization"></label>
    <label>Type of organisation *
      <select name="contact[Organisation type]" required>
        <option value="">Choose…</option>
        <option>Clinic</option><option>GP practice</option><option>Dental practice</option>
        <option>Pharmacy</option><option>Old-age / care home</option><option>School</option>
        <option>Home-care nursing</option><option>Government hospital / facility</option><option>Other</option>
      </select>
    </label>
    <label>Email *<input type="email" name="contact[email]" required autocomplete="email"></label>
    <label>Phone / WhatsApp *<input type="tel" name="contact[phone]" required autocomplete="tel"></label>
    <label>Delivery postal code *<input name="contact[Postal code]" required inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="postal-code"></label>

    {%- if is_quote -%}
      <label>Products and quantities *
        <textarea name="contact[body]" rows="7" required placeholder="e.g. Nitrile gloves size M – 20 boxes&#10;Gauze swabs 10x10 – 10 packs"></textarea>
      </label>
      <label>Order number / tender reference (optional)<input name="contact[Reference]"></label>
      <label>Needed by (optional)<input type="date" name="contact[Needed by]"></label>
    {%- else -%}
      <label>Practice number / registration number (optional)<input name="contact[Practice number]"></label>
      <label>Billing address *<textarea name="contact[Billing address]" rows="3" required></textarea></label>
      <label>Estimated monthly spend
        <select name="contact[Monthly spend]">
          <option>Under R2,000</option><option>R2,000 – R10,000</option><option>R10,000 – R50,000</option><option>Over R50,000</option>
        </select>
      </label>
      <label>Anything else we should know?<textarea name="contact[body]" rows="3"></textarea></label>
    {%- endif -%}

    <label class="md-form__check">
      <input type="checkbox" name="contact[POPIA consent]" value="Yes" required>
      I agree that Micheals Dynamics may use these details to respond to this request, as described in the
      <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>.
    </label>

    <button type="submit" class="md-form__submit">{% if is_quote %}Send quote request{% else %}Apply for a business account{% endif %}</button>
  {%- endform -%}

  {%- if is_quote -%}
    <p class="md-form__alt">
      Have an order list (Excel, PDF or photo)? Email it to
      <a href="mailto:{{ section.settings.email }}?subject=Quote%20request">{{ section.settings.email }}</a>
      {%- if wa_number != blank %} or send it on <a href="https://wa.me/{{ wa_number }}?text={{ 'Hi, I would like a quote. My order list is attached.' | url_encode }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}.
    </p>
  {%- endif -%}
</section>

<style>
  .md-form { max-width: 68rem; padding: 2.4rem 1.6rem 4rem; }
  .md-form__form { display: grid; gap: 1.4rem; }
  .md-form label { display: grid; gap: .4rem; font-weight: 600; font-size: 1.5rem; }
  .md-form input, .md-form select, .md-form textarea { font: inherit; font-weight: 400; padding: 1rem 1.2rem; border: 1px solid #8A989E; border-radius: .6rem; background: #fff; }
  .md-form__check { display: flex !important; gap: .8rem; align-items: flex-start; font-weight: 400 !important; }
  .md-form__check input { margin-top: .4rem; }
  .md-form__submit { background: #0B6E78; color: #fff; border: 0; border-radius: .6rem; padding: 1.4rem; font-size: 1.6rem; font-weight: 700; cursor: pointer; }
  .md-form__ok { background: #E7F5EC; border-left: 4px solid #1F7A3A; padding: 1rem 1.2rem; }
  .md-form__alt { margin-top: 2rem; padding: 1.2rem; background: #F2F8F9; border-radius: .6rem; }
  .md-form a { color: #0B6E78; }
</style>

{% schema %}
{
  "name": "MD Request form",
  "settings": [
    { "type": "select", "id": "mode", "label": "Form type", "default": "quote",
      "options": [ { "value": "quote", "label": "Request a quote" }, { "value": "account", "label": "Business account application" } ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Request a quote" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Ordering in bulk for a clinic, practice, school or facility? Tell us what you need and we will send a written quote, usually within one business day.</p>" },
    { "type": "text", "id": "email", "label": "Email for order lists", "default": "michealsdynamicresults@gmail.com" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (international format, no +)", "default": "27747423962" }
  ],
  "presets": [{ "name": "MD Request form" }]
}
{% endschema %}
