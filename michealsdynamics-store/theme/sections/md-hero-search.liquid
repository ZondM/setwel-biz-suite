{%- comment -%}
  Micheals Dynamics — homepage hero: headline, product search and WhatsApp order button.
  Add it in Customize > Home page > Add section > "MD Hero with search".
{%- endcomment -%}

{%- liquid
  assign wa_number = section.settings.whatsapp_number | remove: ' ' | remove: '+'
  assign wa_text = section.settings.whatsapp_message | url_encode
-%}

<section class="md-hero">
  <div class="page-width md-hero__inner">
    <h1 class="md-hero__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="md-hero__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <form action="{{ routes.search_url }}" method="get" role="search" class="md-hero__search">
      <input type="hidden" name="type" value="product">
      <label for="md-hero-q" class="visually-hidden">Search products</label>
      <input id="md-hero-q" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off">
      <button type="submit">Search</button>
    </form>

    <div class="md-hero__actions">
      {%- if section.settings.button_link != blank -%}
        <a class="md-btn md-btn--solid" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
      {%- if wa_number != blank -%}
        <a class="md-btn md-btn--wa" href="https://wa.me/{{ wa_number }}?text={{ wa_text }}" target="_blank" rel="noopener">
          Order on WhatsApp
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.trust_line != blank -%}
      <p class="md-hero__trust">{{ section.settings.trust_line | escape }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .md-hero { background: #F2F8F9; padding: 3.2rem 0 3.6rem; }
  .md-hero__inner { max-width: 82rem; text-align: center; }
  .md-hero__title { font-size: clamp(2.6rem, 6vw, 4.2rem); line-height: 1.15; margin: 0 0 1rem; color: #10202A; }
  .md-hero__sub { font-size: 1.7rem; color: #34444C; margin: 0 0 2rem; }
  .md-hero__search { display: flex; gap: .6rem; max-width: 60rem; margin: 0 auto 1.6rem; }
  .md-hero__search input { flex: 1; min-width: 0; font-size: 1.6rem; padding: 1.2rem 1.4rem; border: 2px solid #0B6E78; border-radius: .6rem; background: #fff; }
  .md-hero__search button { font-size: 1.6rem; padding: 0 1.8rem; border: 0; border-radius: .6rem; background: #0B6E78; color: #fff; font-weight: 700; cursor: pointer; }
  .md-hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  .md-btn { display: inline-block; padding: 1.2rem 2rem; border-radius: .6rem; font-weight: 700; font-size: 1.5rem; text-decoration: none; }
  .md-btn--solid { background: #10202A; color: #fff; }
  .md-btn--wa { background: #1E8E4A; color: #fff; }
  .md-hero__trust { margin-top: 1.6rem; font-size: 1.4rem; color: #34444C; }
</style>

{% schema %}
{
  "name": "MD Hero with search",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "Medical supplies in Cape Town — delivered next day" },
    { "type": "text", "id": "subheading", "label": "Sub-headline", "default": "Gloves, dressings, syringes, swabs, IV sets and PPE for clinics, practices, pharmacies and home care." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search e.g. nitrile gloves, gauze swabs, 5 ml syringe" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (international format, no +)", "default": "27747423962" },
    { "type": "text", "id": "whatsapp_message", "label": "WhatsApp pre-filled message", "default": "Hi Micheals Dynamics, I would like to place an order:" },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "SAHPRA licensed · Free delivery over R2,000 · Next-day delivery in Cape Town" }
  ],
  "presets": [{ "name": "MD Hero with search" }]
}
{% endschema %}
