{%- comment -%}
  Micheals Dynamics — delivery estimate by postal code (cart page and Delivery page).
  This is an ESTIMATE shown to shoppers. The real charge is set in Settings > Shipping and delivery,
  so keep these numbers the same as your shipping settings.
  Add it in Customize > Cart > Add section > "MD Delivery estimator".
{%- endcomment -%}

<section class="md-est page-width">
  <h2>{{ section.settings.heading | escape }}</h2>
  <form class="md-est__form" onsubmit="return false;">
    <label for="md-est-pc-{{ section.id }}" class="visually-hidden">Postal code</label>
    <input id="md-est-pc-{{ section.id }}" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" placeholder="Postal code e.g. 7784">
    <button type="submit">Check</button>
  </form>
  <p class="md-est__result" aria-live="polite"></p>
</section>

<script>
  (function () {
    var s = {
      ranges: {{ section.settings.local_ranges | json }},
      localRate: {{ section.settings.local_rate | json }},
      localLabel: {{ section.settings.local_label | json }},
      nationalRate: {{ section.settings.national_rate | json }},
      nationalLabel: {{ section.settings.national_label | json }},
      freeOver: {{ section.settings.free_over | json }},
      cartTotal: {{ cart.total_price | divided_by: 100.0 | json }}
    };
    var root = document.currentScript.previousElementSibling;
    var form = root.querySelector('form');
    var out = root.querySelector('.md-est__result');

    function isLocal(pc) {
      return s.ranges.split(',').some(function (r) {
        var p = r.trim().split('-');
        var lo = parseInt(p[0], 10), hi = parseInt(p[1] || p[0], 10);
        return pc >= lo && pc <= hi;
      });
    }

    form.addEventListener('submit', function () {
      var raw = form.querySelector('input').value.trim();
      if (!/^\d{4}$/.test(raw)) { out.textContent = 'Please enter a 4-digit South African postal code.'; return; }
      fetch('{{ routes.cart_url }}.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) { s.cartTotal = cart.total_price / 100; })
        .catch(function () {})
        .then(function () { show(raw); });
    });

    function show(raw) {
      var local = isLocal(parseInt(raw, 10));
      var rate = local ? s.localRate : s.nationalRate;
      var label = local ? s.localLabel : s.nationalLabel;
      var free = s.cartTotal >= s.freeOver;
      out.textContent = label + ': ' + (free ? 'FREE (order over R' + s.freeOver.toLocaleString('en-ZA') + ')' : 'R' + rate.toFixed(2)) +
        (free || s.cartTotal === 0 ? '' : ' — spend R' + (s.freeOver - s.cartTotal).toFixed(2) + ' more for free delivery.');
    }
  })();
</script>

<style>
  .md-est { padding: 2rem 1.6rem; }
  .md-est__form { display: flex; gap: .6rem; max-width: 40rem; }
  .md-est__form input { flex: 1; min-width: 0; font-size: 1.6rem; padding: 1rem 1.2rem; border: 1px solid #8A989E; border-radius: .6rem; }
  .md-est__form button { background: #0B6E78; color: #fff; border: 0; border-radius: .6rem; padding: 0 1.8rem; font-weight: 700; font-size: 1.5rem; cursor: pointer; }
  .md-est__result { font-weight: 600; margin-top: 1rem; }
</style>

{% schema %}
{
  "name": "MD Delivery estimator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Check delivery cost" },
    { "type": "text", "id": "local_ranges", "label": "Cape Town postal-code ranges", "default": "7100-7999, 8000-8099", "info": "Comma separated. Check these match the areas you deliver to next day." },
    { "type": "text", "id": "local_label", "label": "Local delivery label", "default": "Cape Town next-day delivery" },
    { "type": "number", "id": "local_rate", "label": "Local delivery price (R)", "default": 80 },
    { "type": "text", "id": "national_label", "label": "Nationwide label", "default": "Nationwide courier (2–4 working days)" },
    { "type": "number", "id": "national_rate", "label": "Nationwide price (R)", "default": 150 },
    { "type": "number", "id": "free_over", "label": "Free delivery from (R)", "default": 2000 }
  ],
  "presets": [{ "name": "MD Delivery estimator" }]
}
{% endschema %}
