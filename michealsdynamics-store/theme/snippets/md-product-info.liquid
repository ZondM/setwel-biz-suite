{%- comment -%}
  Micheals Dynamics — product page extras.
  Shows: sterile badge, pack size, price per item, stock status, bulk price tiers,
  specifications, data sheet download and the returns notice.

  HOW TO USE (Dawn theme):
  Online Store > Themes > Customize > Products > Default product >
  Add block "Custom liquid" (place it under Price) and paste:
    {% render 'md-product-info', product: product %}

  Uses these product metafields (Settings > Custom data > Products):
    custom.pack_quantity  (Integer)          e.g. 100
    custom.unit_label     (Single line text) e.g. glove
    custom.sterile        (True or false)
    custom.material       (Single line text) e.g. Nitrile
    custom.bulk_tiers     (Single line text) e.g. 10:5, 50:10  (10+ packs = 5% off, 50+ = 10% off)
    custom.specs          (Multi-line text)
    custom.datasheet      (File)
{%- endcomment -%}

{%- liquid
  assign low_stock = low_stock | default: 20
  assign pack_qty = product.metafields.custom.pack_quantity.value | default: 1
  assign unit_label = product.metafields.custom.unit_label.value | default: 'item'
  assign sterile = product.metafields.custom.sterile.value
  assign tiers_raw = product.metafields.custom.bulk_tiers.value | default: ''
  assign tiers = tiers_raw | split: ','
  assign returns_page = pages['delivery-returns']
-%}

<div class="md-info" id="md-info-{{ product.id }}">
  <div class="md-badges">
    {%- if sterile == true -%}
      <span class="md-badge md-badge--sterile">Sterile</span>
    {%- elsif sterile == false -%}
      <span class="md-badge">Non-sterile</span>
    {%- endif -%}
    {%- if product.metafields.custom.material.value != blank -%}
      <span class="md-badge">{{ product.metafields.custom.material.value | escape }}</span>
    {%- endif -%}
    {%- if pack_qty > 1 -%}
      <span class="md-badge">Pack of {{ pack_qty }}</span>
    {%- endif -%}
  </div>

  <p class="md-per-item" data-md-per-item></p>
  <p class="md-stock" data-md-stock></p>

  {%- if tiers.size > 0 -%}
    <div class="md-tiers">
      <p class="md-tiers__title">Bulk pricing</p>
      <table>
        <thead><tr><th>Quantity</th><th>Price per pack</th><th>Saving</th></tr></thead>
        <tbody data-md-tiers></tbody>
      </table>
      <p class="md-small">Bulk discount is applied automatically in the cart.</p>
    </div>
  {%- endif -%}

  {%- if product.metafields.custom.specs.value != blank -%}
    <details class="md-specs" open>
      <summary>Specifications</summary>
      <div>{{ product.metafields.custom.specs.value | escape | newline_to_br }}</div>
    </details>
  {%- endif -%}

  {%- if product.metafields.custom.datasheet.value != blank -%}
    <a class="md-datasheet" href="{{ product.metafields.custom.datasheet.value.url }}" target="_blank" rel="noopener" download>
      Download product data sheet (PDF)
    </a>
  {%- endif -%}

  <p class="md-returns">
    Sterile items and opened packs cannot be returned unless they are faulty.
    {%- if returns_page != blank %} <a href="{{ returns_page.url }}">Delivery &amp; Returns</a>{% endif -%}
  </p>
</div>

<script type="application/json" id="md-data-{{ product.id }}">
{
  "pack": {{ pack_qty | json }},
  "unit": {{ unit_label | json }},
  "lowStock": {{ low_stock | json }},
  "tiers": [{%- for t in tiers -%}{%- assign p = t | split: ':' -%}{%- if p.size == 2 -%}{"min": {{ p[0] | strip | plus: 0 }}, "pct": {{ p[1] | strip | plus: 0 }}}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}{%- endfor -%}],
  "variants": {
    {%- for v in product.variants -%}
      "{{ v.id }}": {"price": {{ v.price }}, "available": {{ v.available }}, "tracked": {% if v.inventory_management %}true{% else %}false{% endif %}, "qty": {{ v.inventory_quantity | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  },
  "current": {{ product.selected_or_first_available_variant.id }}
}
</script>

<script>
  (function () {
    var root = document.getElementById('md-info-{{ product.id }}');
    var data = JSON.parse(document.getElementById('md-data-{{ product.id }}').textContent);

    function money(cents) {
      var n = (Math.round(cents) / 100).toFixed(2).split('.');
      return 'R ' + n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + n[1];
    }

    function render(id) {
      var v = data.variants[id];
      if (!v) return;

      var perItem = root.querySelector('[data-md-per-item]');
      perItem.textContent = data.pack > 1 ? money(v.price / data.pack) + ' per ' + data.unit : '';

      var stock = root.querySelector('[data-md-stock]');
      var text = 'In stock', cls = 'in';
      if (!v.available) { text = 'Out of stock'; cls = 'out'; }
      else if (v.tracked && v.qty <= 0) { text = 'Available on back-order'; cls = 'low'; }
      else if (v.tracked && v.qty <= data.lowStock) { text = 'Low stock — order soon'; cls = 'low'; }
      stock.textContent = text;
      stock.className = 'md-stock md-stock--' + cls;

      var body = root.querySelector('[data-md-tiers]');
      if (body && !data.tiers.length) {
        root.querySelector('.md-tiers').hidden = true;
      } else if (body) {
        var rows = '<tr><td>1–' + (data.tiers.length ? data.tiers[0].min - 1 : '') + '</td><td>' + money(v.price) + '</td><td>—</td></tr>';
        data.tiers.forEach(function (t, i) {
          var next = data.tiers[i + 1];
          var range = next ? t.min + '–' + (next.min - 1) : t.min + '+';
          rows += '<tr><td>' + range + '</td><td>' + money(v.price * (100 - t.pct) / 100) + '</td><td>' + t.pct + '%</td></tr>';
        });
        body.innerHTML = rows;
      }
    }

    function currentId() {
      var input = document.querySelector('form[action*="/cart/add"] input[name="id"]');
      return input && input.value ? input.value : String(data.current);
    }

    render(String(data.current));

    // Dawn announces variant changes via its pub/sub helper; fall back to watching the form.
    if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.variantChange) {
      subscribe(PUB_SUB_EVENTS.variantChange, function (e) {
        var v = e && e.data && e.data.variant;
        render(v ? String(v.id) : currentId());
      });
    }
    document.addEventListener('change', function () {
      setTimeout(function () { render(currentId()); }, 400);
    });
  })();
</script>

<style>
  .md-info { margin: 1rem 0; font-size: 1.5rem; }
  .md-badges { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: .8rem; }
  .md-badge { border: 1px solid #0B6E78; color: #0B6E78; border-radius: 2rem; padding: .2rem 1rem; font-size: 1.3rem; }
  .md-badge--sterile { background: #0B6E78; color: #fff; }
  .md-per-item { margin: .2rem 0; font-weight: 600; }
  .md-stock { margin: .2rem 0 1rem; font-weight: 600; }
  .md-stock--in { color: #1F7A3A; }
  .md-stock--low { color: #9A5B00; }
  .md-stock--out { color: #B42318; }
  .md-tiers table { width: 100%; border-collapse: collapse; font-size: 1.4rem; }
  .md-tiers th, .md-tiers td { border-bottom: 1px solid #E3E8EA; padding: .6rem .4rem; text-align: left; }
  .md-tiers__title { font-weight: 700; margin: 1rem 0 .4rem; }
  .md-small { font-size: 1.3rem; color: #4A5559; }
  .md-specs { margin: 1.2rem 0; }
  .md-specs summary { font-weight: 700; cursor: pointer; }
  .md-datasheet { display: inline-block; margin: .6rem 0; color: #0B6E78; font-weight: 600; }
  .md-returns { font-size: 1.3rem; color: #4A5559; border-left: 3px solid #0B6E78; padding-left: .8rem; }
</style>
