{%- comment -%}
  Micheals Dynamics — compliance line for the footer + floating WhatsApp button (shows on every page).
  Add it in Customize > Footer > Add section > "MD Compliance bar".
{%- endcomment -%}

{%- assign wa_number = section.settings.whatsapp_number | remove: ' ' | remove: '+' -%}

<div class="md-compliance">
  <div class="page-width">
    <p>
      <strong>{{ section.settings.legal_name | escape }}</strong>
      {%- if section.settings.reg_no != blank %} · Company reg. no. {{ section.settings.reg_no | escape }}{% endif %}
      {%- if section.settings.sahpra_no != blank %} · SAHPRA licence no. {{ section.settings.sahpra_no | escape }}{% endif %}
      {%- if section.settings.vat_text != blank %} · {{ section.settings.vat_text | escape }}{% endif %}
    </p>
    <p>{{ section.settings.address | escape }}</p>
    <p>
      {{ section.settings.disclaimer | escape }}
      {%- if section.settings.gbp_url != blank %} · <a href="{{ section.settings.gbp_url }}" target="_blank" rel="noopener">Find us on Google</a>{% endif %}
    </p>
  </div>
</div>

{%- if section.settings.show_whatsapp and wa_number != blank -%}
  <a class="md-wa-float" href="https://wa.me/{{ wa_number }}?text={{ section.settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener" aria-label="Order on WhatsApp">
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-4-.5-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.4z"/></svg>
    <span>WhatsApp</span>
  </a>
{%- endif -%}

<style>
  .md-compliance { border-top: 1px solid #E3E8EA; padding: 1.6rem 0 2rem; font-size: 1.3rem; color: #34444C; }
  .md-compliance p { margin: .3rem 0; }
  .md-compliance a { color: #0B6E78; }
  .md-wa-float { position: fixed; right: 1.6rem; bottom: 1.6rem; z-index: 50; display: flex; align-items: center; gap: .6rem;
    background: #1E8E4A; color: #fff; padding: 1rem 1.4rem; border-radius: 3rem; font-weight: 700; font-size: 1.4rem;
    text-decoration: none; box-shadow: 0 4px 14px rgba(0,0,0,.2); }
</style>

{% schema %}
{
  "name": "MD Compliance bar",
  "tag": "div",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "legal_name", "label": "Registered business name", "default": "Micheals Dynamics (Pty) Ltd" },
    { "type": "text", "id": "reg_no", "label": "Company registration number", "default": "2024/551935/07" },
    { "type": "text", "id": "sahpra_no", "label": "SAHPRA licence number", "default": "00005896MD" },
    { "type": "text", "id": "vat_text", "label": "VAT line", "default": "Not VAT registered — no VAT is charged" },
    { "type": "text", "id": "address", "label": "Address", "default": "33483 Hluhla Street, Harare, Khayelitsha, Cape Town, 7784" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Product information is for identification only and is not medical advice. Use products as directed by the manufacturer." },
    { "type": "url", "id": "gbp_url", "label": "Google Business Profile link" },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Show floating WhatsApp button", "default": true },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (international format, no +)", "default": "27747423962" },
    { "type": "text", "id": "whatsapp_message", "label": "WhatsApp pre-filled message", "default": "Hi Micheals Dynamics, I would like to place an order:" }
  ],
  "presets": [{ "name": "MD Compliance bar" }]
}
{% endschema %}
